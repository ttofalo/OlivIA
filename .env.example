# ---- WhatsApp (gateway) ----
# Números autorizados, con código de país, separados por coma.
WSP_ALLOWED_NUMBERS=5493511234567,5493517654321
# Chat donde el bot manda las alertas automáticas (número o id de grupo).
WSP_ALERT_CHAT=5493511234567
# Cómo la llama la familia. En grupos solo responde cuando la nombran.
WSP_BOT_NAME=olivia

# ---- Jev / TypeSafe (brain) ----
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Por debajo de este umbral, el brain escala al LLM de nivel 2 en vez de ejecutar.
JEV_CONFIDENCE_THRESHOLD=0.80

# ---- LLM (brain, nivel 2) ----
# Sirve cualquier proveedor OpenAI-compatible. Por ejemplo, NVIDIA Build:
# https://integrate.api.nvidia.com/v1 con el modelo moonshotai/kimi-k3.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# deepseek-v4-pro contesta directo y limpio. deepseek-flash razona y con pocos
# tokens devuelve vacío; si se usa, subir LLM_MAX_TOKENS.
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT=20
# Esfuerzo del modelo: low = más rápido, sin razonamiento largo.
LLM_EFFORT=low
LLM_MAX_TOKENS=512
# Dónde anota el brain cada llamada a Jev y DeepSeek con tokens y USD.
# Se consulta por chat ("cuánto gastamos?"). Está en el volumen media, así que persiste.
COSTS_PATH=/media/costos.jsonl

# Bot de Telegram para avisos: la sesión de WhatsApp se cae o vuelve (gateway),
# y el reporte diario de gasto a las 21hs Argentina (brain, por cron). Creá el
# bot con @BotFather, escribile /start desde tu cuenta y conseguí tu chat_id
# con https://api.telegram.org/bot<token>/getUpdates. Vacío = no manda nada.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Transcripción de audios ----
# api = servicio OpenAI-compatible. Groq tiene plan gratis (sin tarjeta) y
# transcribe en menos de 1 s; la clave sale de console.groq.com.
# local = faster-whisper en la CPU del VPS (2 s con "base" en 1 CPU). Con
# api, si la API falla, el brain cae solo a local con "base".
TRANSCRIBE_BACKEND=api
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_API_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=

# ---- MQTT ----
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_TLS=true
# Ruta al ca.crt del broker dentro del contenedor. El broker usa una CA propia,
# así que los clientes tienen que confiar en ella. En el VPS se monta por compose.
MQTT_CA_CERT=/certs/ca.crt
MQTT_USER_GATEWAY=gateway
MQTT_PASS_GATEWAY=
MQTT_USER_BRAIN=brain
MQTT_PASS_BRAIN=
MQTT_USER_AGENT=agent
MQTT_PASS_AGENT=

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_DB=olivia
POSTGRES_USER=olivia
POSTGRES_PASSWORD=

# ---- Agente local (va en la Pi, no en el VPS) ----
# Host público del VPS al que se conecta el agente.
VPS_MQTT_HOST=
