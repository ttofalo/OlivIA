# ---- WhatsApp (gateway) ----
# Números autorizados, con código de país, separados por coma.
WSP_ALLOWED_NUMBERS=5493511234567,5493517654321
# Chat donde el bot manda las alertas automáticas (número o id de grupo).
WSP_ALERT_CHAT=5493511234567

# ---- Jev / TypeSafe (brain) ----
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Por debajo de este umbral, el brain escala a Claude en vez de ejecutar.
JEV_CONFIDENCE_THRESHOLD=0.80

# ---- Claude (brain, nivel 2) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Transcripción de audios ----
# local = whisper.cpp en el VPS, api = servicio externo
TRANSCRIBE_BACKEND=local
TRANSCRIBE_MODEL=base

# ---- MQTT ----
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER_GATEWAY=gateway
MQTT_PASS_GATEWAY=
MQTT_USER_BRAIN=brain
MQTT_PASS_BRAIN=
MQTT_USER_AGENT=agent
MQTT_PASS_AGENT=

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_DB=camaritas
POSTGRES_USER=camaritas
POSTGRES_PASSWORD=

# ---- Agente local (va en la Pi, no en el VPS) ----
# Host público del VPS al que se conecta el agente.
VPS_MQTT_HOST=
MEDIA_UPLOAD_URL=
MEDIA_UPLOAD_TOKEN=
